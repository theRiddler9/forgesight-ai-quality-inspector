{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesight.local/schemas/inspection-event-v1.json",
  "title": "ForgeSight Inspection Event",
  "description": "Canonical audit event emitted once for each completed inspection attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "part_id",
    "result",
    "defects",
    "poka_yoke",
    "latency_ms",
    "soc_temperature_c",
    "image",
    "model",
    "configuration_version",
    "operator_review",
    "faults"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "RECHECK"]
    },
    "defects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defect"
      }
    },
    "poka_yoke": {
      "$ref": "#/$defs/pokaYoke"
    },
    "latency_ms": {
      "$ref": "#/$defs/latency"
    },
    "soc_temperature_c": {
      "type": ["number", "null"],
      "minimum": -40,
      "maximum": 125
    },
    "image": {
      "$ref": "#/$defs/imageReference"
    },
    "model": {
      "$ref": "#/$defs/modelReference"
    },
    "configuration_version": {
      "type": "string",
      "minLength": 1
    },
    "operator_review": {
      "$ref": "#/$defs/operatorReview"
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_fixture", "scenario_driven_detector", "mock_io"],
      "properties": {
        "synthetic_fixture": { "const": true },
        "scenario_driven_detector": { "type": "boolean" },
        "mock_io": { "const": true }
      }
    },
    "scenario": { "type": "string", "minLength": 1 },
    "component_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint", "validation_status", "calibration_reference", "thresholds", "detector_backend"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_status": { "enum": ["provisional", "replay_validated", "real_approved"] },
        "calibration_reference": { "type": ["string", "null"] },
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["fail_confidence", "recheck_confidence"],
          "properties": {
            "fail_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "recheck_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "detector_backend": { "enum": ["scenario_simulation", "onnx", "rknn"] }
      }
    },
    "mock_io_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["green", "red", "amber", "buzzer", "ring_light_pwm"],
      "properties": {
        "green": { "type": "boolean" },
        "red": { "type": "boolean" },
        "amber": { "type": "boolean" },
        "buzzer": { "type": "boolean" },
        "ring_light_pwm": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "confidence", "bbox_normalized"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox_normalized": {
          "type": ["array", "null"],
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "pokaYoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_present",
        "position_ok",
        "orientation_ok",
        "hole_present",
        "size_in_range",
        "reasons"
      ],
      "properties": {
        "part_present": { "type": "boolean" },
        "position_ok": { "type": ["boolean", "null"] },
        "orientation_ok": { "type": ["boolean", "null"] },
        "hole_present": { "type": ["boolean", "null"] },
        "size_in_range": { "type": ["boolean", "null"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "preprocess",
        "poka_yoke",
        "inference",
        "postprocess",
        "decision",
        "io",
        "total"
      ],
      "properties": {
        "capture": { "type": "number", "minimum": 0 },
        "preprocess": { "type": "number", "minimum": 0 },
        "poka_yoke": { "type": "number", "minimum": 0 },
        "inference": { "type": "number", "minimum": 0 },
        "postprocess": { "type": "number", "minimum": 0 },
        "decision": { "type": "number", "minimum": 0 },
        "io": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      }
    },
    "imageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "input_uri", "evidence_uri", "sha256"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "input_uri": { "type": "string", "minLength": 1 },
        "evidence_uri": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "modelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "artifact_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": {
          "type": "string",
          "enum": ["mock", "pytorch", "onnx", "rknn"]
        },
        "artifact_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "operatorReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_at",
        "reviewer_id",
        "corrected_result",
        "note"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NOT_REQUIRED", "PENDING", "CONFIRMED", "CORRECTED"]
        },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_id": { "type": ["string", "null"] },
        "corrected_result": {
          "type": ["string", "null"],
          "enum": ["PASS", "FAIL", "RECHECK", null]
        },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
