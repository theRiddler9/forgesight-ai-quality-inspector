{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgesight.local/schemas/inference-benchmark-v1.json",
  "title": "ForgeSight Inference Benchmark Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at", "model_id", "artifact", "target_label",
    "target_label_is_metadata_only", "warmup_runs", "repetitions", "frame_count",
    "latency_ms", "environment"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "model_id": { "type": "string", "minLength": 1 },
    "artifact": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "size_bytes", "sha256"],
          "properties": {
            "filename": { "type": "string", "minLength": 1 },
            "size_bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "target_label": { "type": "string", "minLength": 1 },
    "target_label_is_metadata_only": { "const": true },
    "warmup_runs": { "type": "integer", "minimum": 0 },
    "repetitions": { "type": "integer", "minimum": 1 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "mean", "median", "p95_nearest_rank", "min", "max"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "mean": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95_nearest_rank": { "type": "number", "minimum": 0 },
        "p99_nearest_rank": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "onnx_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend", "profile_id", "profile_version", "profile_fingerprint",
        "model_version", "model_purpose", "preprocessing_fingerprint"
      ],
      "properties": {
        "backend": { "const": "onnx" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 },
        "profile_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "model_purpose": { "enum": ["adapter_test_fixture", "trained_unverified", "trained_validated"] },
        "preprocessing_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "execution_providers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "model_initialization_ms": { "type": "number", "minimum": 0 },
        "timing_scope": { "const": "detector_call_including_preprocess_postprocess" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version", "platform", "machine", "processor", "hardware_model",
        "runtime_packages", "soc_temp_c_before", "soc_temp_c_after"
      ],
      "properties": {
        "python_version": { "type": "string" },
        "platform": { "type": "string" },
        "machine": { "type": "string" },
        "processor": { "type": ["string", "null"] },
        "hardware_model": { "type": ["string", "null"] },
        "runtime_packages": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "soc_temp_c_before": { "type": ["number", "null"] },
        "soc_temp_c_after": { "type": ["number", "null"] }
      }
    }
  }
}
